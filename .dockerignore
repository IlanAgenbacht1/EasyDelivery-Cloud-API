[Dd]ebugPS/
[Rr]eleasePS/

# .NET Core build outputs
*.dll
*.exe
*.pdb

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
*.suo
*.user
*.userosscache
*.sln.docstates

# Log files
*.log

# Temporary files
*.tmp
*.temp
# .dockerignore

# Git files
.git/
.gitignore

# Build output directories
bin/
obj/

# Debug and release directories
**/bin/
**/obj/

# Visual Studio directories
.vs/
.vscode/

# NuGet packages folder
packages/

# MSTest test Results
TestResults/

